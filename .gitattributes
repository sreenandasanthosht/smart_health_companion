# Normalise line endings.
#
# Without this, a file edited on Windows (CRLF) and one edited on Mac/Linux
# (LF) look completely rewritten to Git even when the text is identical --
# which makes diffs unreadable and causes a merge conflict on every file.
#
# `text=auto` stores everything as LF in the repository and converts to the
# platform's native ending on checkout. Nobody has to think about it again.
* text=auto

# Binary files: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.gz binary
*.zip binary
*.sqlite3 binary
