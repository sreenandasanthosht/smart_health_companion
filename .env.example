# Copy this file to ".env" and fill in real values on each laptop.
# The real .env file is NOT committed to git (it holds secrets).

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL database ---
DB_NAME=smart_health_companion
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Set USE_SQLITE=1 to quickly test WITHOUT MySQL (uses a local file db).
USE_SQLITE=0


# --- Prescription extraction (Phase 2) ---
# Windows: point this at the Tesseract you installed.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Structuring the OCR text. Leave LLM_API_KEY empty to use the local
# rule-based parser only -- nothing is sent anywhere in that mode.
# Get a free Gemini key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=20
