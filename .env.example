# Copy this file to ".env" and fill in real values on each laptop.
# The real .env file is NOT committed to git (it holds secrets).

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL database ---
# CareNest uses MySQL. We each run our own MySQL server on our own laptop,
# both using the SAME database name below, so the two installs are identical.
# The table STRUCTURE is shared through the migration files in Git; the DATA
# is shared through `python manage.py seed_demo`. See SETUP_GUIDE.md section G.
DB_NAME=smart_health_companion
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Only needed if the database is ever moved to a hosted provider (Aiven, RDS)
# that requires an encrypted connection. Leave EMPTY for a local MySQL.
DB_SSL_CA=

# Set USE_SQLITE=1 to work on a throwaway local file database with no MySQL
# at all -- useful for a quick test, but it is not the real database and
# nothing there is shared. Keep this at 0 for normal work.
USE_SQLITE=0


# --- Prescription extraction (Phase 2) ---
# Windows: point this at the Tesseract you installed.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Structuring the OCR text. Leave LLM_API_KEY empty to use the local
# rule-based parser only -- nothing is sent anywhere in that mode.
# Get a free Gemini key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=20
